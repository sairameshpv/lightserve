{
  "uid": "lightserve",
  "title": "lightserve",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "schemaVersion": 41,
  "panels": [
    {"type": "stat", "title": "Up", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "up{job=\"lightserve\"}"}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}},
    {"type": "timeseries", "title": "Throughput (tokens/s)", "gridPos": {"x": 4, "y": 0, "w": 10, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(lightserve_generated_tokens_total[1m])", "legendFormat": "tokens/s"}]},
    {"type": "timeseries", "title": "Requests ended per second, by status", "gridPos": {"x": 14, "y": 0, "w": 10, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (status) (rate(lightserve_requests_total[1m]))", "legendFormat": "{{status}}"}]},
    {"type": "timeseries", "title": "Time to first token", "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(lightserve_time_to_first_token_seconds_bucket[1m])))", "legendFormat": "p50"},
                 {"expr": "histogram_quantile(0.99, sum by (le) (rate(lightserve_time_to_first_token_seconds_bucket[1m])))", "legendFormat": "p99"}]},
    {"type": "timeseries", "title": "Time between tokens", "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(lightserve_inter_token_seconds_bucket[1m])))", "legendFormat": "p50"},
                 {"expr": "histogram_quantile(0.99, sum by (le) (rate(lightserve_inter_token_seconds_bucket[1m])))", "legendFormat": "p99"}]},
    {"type": "timeseries", "title": "Whole request", "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(lightserve_request_seconds_bucket[1m])))", "legendFormat": "p50"},
                 {"expr": "histogram_quantile(0.99, sum by (le) (rate(lightserve_request_seconds_bucket[1m])))", "legendFormat": "p99"}]},
    {"type": "timeseries", "title": "Requests in flight / waiting / running", "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "lightserve_requests_in_flight", "legendFormat": "in flight (HTTP)"},
                 {"expr": "lightserve_requests_waiting", "legendFormat": "waiting"},
                 {"expr": "lightserve_requests_running", "legendFormat": "running"}]},
    {"type": "timeseries", "title": "Queue wait (arrival to first scheduled)", "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(lightserve_queue_wait_seconds_bucket[1m])))", "legendFormat": "p50"},
                 {"expr": "histogram_quantile(0.99, sum by (le) (rate(lightserve_queue_wait_seconds_bucket[1m])))", "legendFormat": "p99"}]},
    {"type": "timeseries", "title": "Engine step time, prefill vs decode (p50)", "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le, kind) (rate(lightserve_step_seconds_bucket[1m])))", "legendFormat": "{{kind}}"}]},
    {"type": "timeseries", "title": "KV-cache usage", "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}},
     "targets": [{"expr": "lightserve_kv_cache_usage", "legendFormat": "used"}]},
    {"type": "timeseries", "title": "Preemptions per second", "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(lightserve_preemptions_total[1m])", "legendFormat": "preemptions/s"}]},
    {"type": "timeseries", "title": "Average batch size (requests per step)", "gridPos": {"x": 16, "y": 24, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(lightserve_batch_size_sum[1m]) / rate(lightserve_batch_size_count[1m])", "legendFormat": "avg"}]},
    {"type": "row", "title": "GPU (DCGM exporter; GPU node only)", "gridPos": {"x": 0, "y": 32, "w": 24, "h": 1}, "panels": []},
    {"type": "timeseries", "title": "GPU busy: any kernel vs tensor cores", "gridPos": {"x": 0, "y": 33, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
     "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL / 100", "legendFormat": "GPU {{gpu}} any kernel"},
                 {"expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE", "legendFormat": "GPU {{gpu}} tensor cores"}]},
    {"type": "timeseries", "title": "GPU memory used", "gridPos": {"x": 8, "y": 33, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "decmbytes"}},
     "targets": [{"expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "GPU {{gpu}} used"},
                 {"expr": "DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE", "legendFormat": "GPU {{gpu}} total"}]},
    {"type": "timeseries", "title": "SM clock (MHz)", "gridPos": {"x": 16, "y": 33, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "GPU {{gpu}}"}]},
    {"type": "timeseries", "title": "Power (W)", "gridPos": {"x": 0, "y": 41, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU {{gpu}}"}]},
    {"type": "timeseries", "title": "Temperature (°C)", "gridPos": {"x": 8, "y": 41, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "GPU {{gpu}}"}]},
    {"type": "timeseries", "title": "Clock held back (bitmask; 0 = full speed)", "gridPos": {"x": 16, "y": 41, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "DCGM_FI_DEV_CLOCKS_EVENT_REASONS", "legendFormat": "GPU {{gpu}}"}]},
    {"type": "row", "title": "Model quality (canary: the same 50 questions every ~5 min)", "gridPos": {"x": 0, "y": 49, "w": 24, "h": 1}, "panels": []},
    {"type": "timeseries", "title": "Canary accuracy vs normal", "gridPos": {"x": 0, "y": 50, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"lineInterpolation": "stepAfter"}}},
     "targets": [{"expr": "canary_accuracy", "legendFormat": "canary accuracy"},
                 {"expr": "canary_expected_accuracy", "legendFormat": "normal (champion's saved score)"},
                 {"expr": "canary_expected_accuracy - 0.10", "legendFormat": "alarm line (CanaryAccuracyLow)"}]}
  ]
}
